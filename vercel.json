{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/:path*" }, { "source": "/(.*)", "destination": "/index.html" }],
  "headers": [{ "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }] }],
  "functions": {
    "api/upload/complete.ts": { "maxDuration": 300, "includeFiles": "node_modules/ffmpeg-static/**" }
  }
}
